# ==============================================================================
# OfferFlow - Environment Configuration (.env.example)
# ==============================================================================

# Database Connection (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/offerflow?schema=public"

# App Base URL
NEXT_PUBLIC_APP_URL="https://offerflow.example.com"
APP_URL="https://offerflow.example.com"

# Revolut Merchant API (Revolut Checkout / Subscriptions)
REVOLUT_API_KEY="sk_sand_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
REVOLUT_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Environment: 'sandbox' or 'production'
REVOLUT_ENVIRONMENT="sandbox"

# Google Gemini API (AI assistance for proposal copywriting)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
